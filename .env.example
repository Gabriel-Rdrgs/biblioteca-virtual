# Senha compartilhada da turma. Enquanto estiver vazia, o site fica ABERTO
# (útil em desenvolvimento) e um aviso aparece no topo de cada página.
ATLAS_SENHA_TURMA=

# Segredo usado para assinar o cookie de sessão. Qualquer texto longo e
# aleatório; troque-o para invalidar todas as sessões de uma vez.
ATLAS_COOKIE_SECRET=
