# Senha compartilhada da turma. Enquanto estiver vazia, o site fica ABERTO
# (útil em desenvolvimento) e um aviso aparece no topo de cada página.
ATLAS_SENHA_TURMA=

# Senha da área administrativa (/admin). Diferente da senha da turma; sem
# ela, /admin simplesmente não existe.
ATLAS_SENHA_ADMIN=

# Segredo usado para assinar o cookie de sessão. Qualquer texto longo e
# aleatório; troque-o para invalidar todas as sessões de uma vez.
ATLAS_COOKIE_SECRET=

# ---- Cloudflare R2 (só em produção). Com as quatro preenchidas, os PDFs são
# servidos do bucket por links assinados; vazias, do disco em storage/livros.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=atlas-livros
